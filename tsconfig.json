{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "downlevelIteration": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "exclude": ["node_modules", "dist"],
  "include": [
    "src/**/*",
    "images.d.ts"
  ]
}
